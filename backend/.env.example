# Copy this file to .env in the project root and fill in the values you need.
# This file is read by the BACKEND ONLY (backend/config.py). The frontend only needs
# BACKEND_URL (set as a normal environment variable, see README) since API keys never
# travel to the browser/Streamlit process.

# --- Embeddings: local by default, no account/key needed at all -------------------------------------
# "local" runs a small free HuggingFace model on your own CPU (first run downloads it).
# Multilingual model (~420MB) so non-English sources (e.g. a YouTube video whose only transcript
# is auto-generated in another language) still retrieve correctly against English questions.
# Switch to "openai" only if you specifically want OpenAI's hosted embeddings instead.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Chat: Groq is primary by default - free, fast, no credit card required -------------------------
# Get a free key at https://console.groq.com/keys (takes ~2 minutes to sign up).
# One of: groq | openrouter | openai. If it fails or has no key, the app automatically
# falls through to the next configured provider below.
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.1-8b-instant

# Voice input (mic button in the chat box): reuses GROQ_API_KEY above via Groq's free Whisper
# endpoint. Falls back to OpenAI's Whisper (OPENAI_API_KEY) if Groq isn't configured or fails.
GROQ_WHISPER_MODEL=whisper-large-v3
OPENAI_WHISPER_MODEL=whisper-1
# Language hint for transcription (ISO-639-1, e.g. "en", "es", "hi"). Leave blank to let Whisper
# auto-detect the language, which is less reliable on short clips.
WHISPER_LANGUAGE=en

# --- Optional additional fallbacks (leave blank to disable) ------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.1-8b-instruct:free

# OpenAI is entirely OPTIONAL now - only needed if you want it as a chat fallback, or if you set
# EMBEDDING_PROVIDER=openai above. NOTE: there is no model literally named "gpt-5.5" - set this
# to whatever real chat model your account has access to (e.g. gpt-4.1, gpt-4o).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Claude (Anthropic) - optional additional chat provider. Get a key at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-5

# Gemini (Google) - optional additional chat provider. Free-tier key at
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_CHAT_MODEL=gemini-2.0-flash

# --- Storage ----------------------------------------------------------------------------------------
CHROMA_PERSIST_DIR=chroma_db
UPLOADS_DIR=uploads
SESSIONS_DIR=.sessions

# --- RAG tuning -------------------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=12
RERANK_TOP_K=5
MAX_DISTANCE=0.9
MAX_HISTORY_TURNS=4

# --- Server -----------------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=*

# --- OCR --------------------------------------------------------------------------------------------
# Windows: only needed if Tesseract isn't on PATH, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- MCP math server -------------------------------------------------------------------------------
# Points at any external MCP-compatible math server reachable over stdio, e.g. Calculator_MCP_Server
# (https://github.com/<you>/Calculator_MCP_Server). COMMAND is the interpreter, ARGS is the script.
# Example:
# MCP_MATH_SERVER_COMMAND=C:\path\to\Calculator_MCP_Server\.venv\Scripts\python.exe
# MCP_MATH_SERVER_ARGS=C:\path\to\Calculator_MCP_Server\server.py
MCP_MATH_SERVER_COMMAND=
MCP_MATH_SERVER_ARGS=
MCP_MATH_TIMEOUT_SECONDS=10

LOG_LEVEL=INFO
